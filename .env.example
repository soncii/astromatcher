# Copy to .env for local development. Never commit .env.
PORT=8080
ADMIN_PASSWORD=replace-with-a-long-random-password
ANALYTICS_SECRET=replace-with-at-least-32-random-characters

# Local analytics are stored in data/analytics.jsonl by default.
# For free deployment on Render set both of the following.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Resolves visitor country by IP when Cloudflare header is absent.
COUNTRY_LOOKUP=on
# TRUST_PROXY_GEO=1  # Set behind Render or another trusted reverse proxy.
